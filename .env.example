YOUTUBE_API_KEY=
PORT=3000
NODE_ENV=production
YOUTUBE_TIMEOUT_MS=30000

# First Railway deployment/testing:
AUTH_MODE=none

# Production Auth0/OIDC mode:
# AUTH_MODE=oauth
# AUTH_ISSUER=https://YOUR_AUTH0_DOMAIN/
# AUTH_AUDIENCE=https://youtube-claude-mcp
# AUTH_JWKS_URL=https://YOUR_AUTH0_DOMAIN/.well-known/jwks.json
# AUTH_REQUIRED_SCOPE=youtube:read

# Railway Redis / Key Value. Recommended, but optional for first deployment.
# In Railway, set REDIS_URL from your Redis service variable when you add Redis.
REDIS_URL=

TRANSCRIPT_CACHE_TTL_SECONDS=604800
VIDEO_DETAILS_CACHE_TTL_SECONDS=900
TRENDING_CACHE_TTL_SECONDS=600
CHANNEL_VIDEOS_CACHE_TTL_SECONDS=600
